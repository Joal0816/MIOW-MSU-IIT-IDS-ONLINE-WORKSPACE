{
  "name": "miow-kiosk-companion",
  "version": "1.0.0",
  "description": "MIOW LMS Hardlock Kiosk Companion Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-packager . miow-kiosk --platform=linux --arch=x64 --out=dist --overwrite",
    "dist:win": "electron-packager . miow-kiosk --platform=win32 --arch=x64 --out=dist --overwrite"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2"
  }
}
