            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "description": "The student's written submission or answer text."
            }
          },
          "required": [
            "assignment_id",
            "content"
          ]
        },
        "outputSchema": null
      },
