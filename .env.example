# MIOW — Environment variables (local Postgres branch)
# Copy to .env and fill values. Never commit .env.
# Generate SESSION_SECRET: openssl rand -hex 32  (32+ random hex chars)

# --- Local Postgres (primary) ---
DATABASE_URL=postgres://miow:miow_dev_password@localhost:5432/miow
# Optional: direct postgres without URL
# PGHOST=localhost
# PGPORT=5432
# PGUSER=miow
# PGPASSWORD=miow_dev_password
# PGDATABASE=miow

# Where local file storage lands (avatars, course-materials)
STORAGE_PATH=./storage

# Optional: Redis for cross-instance rate-limit (5/15m). If unset, uses in-memory.
# REDIS_URL=redis://localhost:6379

# --- Legacy Supabase (kept for main branch compat, not used in this branch) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

SESSION_SECRET=
HARDWARE_API_KEY=
OPENCODE_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Debug logging (set to true to see console.debug in browser + server)
# VITE_DEBUG_LOGS=true
# DEBUG_LOGS=true
